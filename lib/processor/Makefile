# Targets owned by lib/processor/. Keep recipes local to this folder.


.PHONY: elf-processor-build macho-processor-build dyld-processor-build elf-processor-dylib avx-shim-build

elf-processor-build:
	@mkdir -p "$(ZIG_CACHE_DIR)/global"
	@cd "$(ROOT_DIR)" && ZIG_LOCAL_CACHE_DIR="$(ZIG_CACHE_DIR)" ZIG_GLOBAL_CACHE_DIR="$(ZIG_GLOBAL_CACHE_DIR)" zig build-exe -O "$(ROSETTE_RUNTIME_OPTIMIZE)" --dep x64_decoder --dep x64_interpreter --dep x64_linux_runtime --dep x64_syscalls --dep x64_guest_abi --dep exit_diagnostics --dep cleo_routing --dep guard_rollback --dep execution_history --dep evex_runtime --dep x86_vector_helpers --dep console_fatal_condition_map --dep console_guest_frontier_map --dep console_warning_severity_map --dep console_guest_milestone_map --dep xenia_guest_address_map --dep frame_content_contract --dep screen_validity --dep address_region_map --dep console_kernel_shim_map --dep console_kernel_export_map --dep arm64_encode --dep tso_memory --dep concurrency --dep parallelism -Mroot="$(ELF_PROCESSOR_SRC)" --dep isa_highway --dep isa_registry --dep isa_decode --dep runtime_abi_handshake --dep flags --dep cpu_state --dep bit_test --dep capabilities -Mx64_decoder=ISA/decoding/root.zig --dep flags -Mcpu_state=src/x64-ASM/cpu_state.zig --dep flags -Mbit_test=src/x64-ASM/bit_test.zig -Mflags=src/x64-ASM/flags.zig -Mcapabilities=src/x64-ASM/capabilities.zig -Mx64_interpreter=src/x64-ASM/interpreter.zig --dep windows_runtime --dep x64_syscalls -Mx64_linux_runtime=src/x64-ASM/linux_runtime.zig -Mx64_syscalls=src/x64-ASM/syscalls.zig --dep dll_win32_return_contract --dep dll_win32_library_inventory --dep windows_bsearch --dep tso_memory --dep utf8_codec -Mwindows_runtime=src/x64-ASM/windows_runtime.zig -Mwindows_bsearch=src/x64-ASM/windows_bsearch.zig -Mdll_win32_return_contract=pkg/dll/win32/return-contract/src/root.zig --dep dll_win32_catalogue --dep dll_win32_capability_gap -Mdll_win32_library_inventory=pkg/dll/win32/library-inventory/src/root.zig --dep dll_win32_advapi32 --dep dll_win32_api_ms_win_crt_convert_l1_1_0 --dep dll_win32_api_ms_win_crt_environment_l1_1_0 --dep dll_win32_api_ms_win_crt_filesystem_l1_1_0 --dep dll_win32_api_ms_win_crt_heap_l1_1_0 --dep dll_win32_api_ms_win_crt_locale_l1_1_0 --dep dll_win32_api_ms_win_crt_math_l1_1_0 --dep dll_win32_api_ms_win_crt_private_l1_1_0 --dep dll_win32_api_ms_win_crt_runtime_l1_1_0 --dep dll_win32_api_ms_win_crt_stdio_l1_1_0 --dep dll_win32_api_ms_win_crt_string_l1_1_0 --dep dll_win32_api_ms_win_crt_time_l1_1_0 --dep dll_win32_api_ms_win_crt_utility_l1_1_0 --dep dll_win32_bcrypt --dep dll_win32_cfgmgr32 --dep dll_win32_dwmapi --dep dll_win32_dxgi --dep dll_win32_vulkan_1 --dep dll_win32_dynamic --dep dll_win32_gdi32 --dep dll_win32_hid --dep dll_win32_imm32 --dep dll_win32_libusbk --dep dll_win32_kernel32 --dep dll_win32_msvcrt --dep dll_win32_ole32 --dep dll_win32_oleaut32 --dep dll_win32_setupapi --dep dll_win32_shcore --dep dll_win32_shell32 --dep dll_win32_shlwapi --dep dll_win32_user32 --dep dll_win32_version --dep dll_win32_winmm --dep dll_win32_winusb --dep dll_win32_wsock32 --dep dll_win32_export_contract -Mdll_win32_catalogue=pkg/dll/win32/catalogue/src/root.zig --dep dll_win32_export_contract -Mdll_win32_advapi32=pkg/dll/win32/advapi32/src/root.zig --dep dll_win32_export_contract -Mdll_win32_api_ms_win_crt_convert_l1_1_0=pkg/dll/win32/api-ms-win-crt-convert-l1-1-0/src/root.zig --dep dll_win32_export_contract -Mdll_win32_api_ms_win_crt_environment_l1_1_0=pkg/dll/win32/api-ms-win-crt-environment-l1-1-0/src/root.zig --dep dll_win32_export_contract -Mdll_win32_api_ms_win_crt_filesystem_l1_1_0=pkg/dll/win32/api-ms-win-crt-filesystem-l1-1-0/src/root.zig --dep dll_win32_export_contract -Mdll_win32_api_ms_win_crt_heap_l1_1_0=pkg/dll/win32/api-ms-win-crt-heap-l1-1-0/src/root.zig --dep dll_win32_export_contract -Mdll_win32_api_ms_win_crt_locale_l1_1_0=pkg/dll/win32/api-ms-win-crt-locale-l1-1-0/src/root.zig --dep dll_win32_export_contract -Mdll_win32_api_ms_win_crt_math_l1_1_0=pkg/dll/win32/api-ms-win-crt-math-l1-1-0/src/root.zig --dep dll_win32_export_contract -Mdll_win32_api_ms_win_crt_private_l1_1_0=pkg/dll/win32/api-ms-win-crt-private-l1-1-0/src/root.zig --dep dll_win32_export_contract -Mdll_win32_api_ms_win_crt_runtime_l1_1_0=pkg/dll/win32/api-ms-win-crt-runtime-l1-1-0/src/root.zig --dep dll_win32_export_contract -Mdll_win32_api_ms_win_crt_stdio_l1_1_0=pkg/dll/win32/api-ms-win-crt-stdio-l1-1-0/src/root.zig --dep dll_win32_export_contract -Mdll_win32_api_ms_win_crt_string_l1_1_0=pkg/dll/win32/api-ms-win-crt-string-l1-1-0/src/root.zig --dep dll_win32_export_contract -Mdll_win32_api_ms_win_crt_time_l1_1_0=pkg/dll/win32/api-ms-win-crt-time-l1-1-0/src/root.zig --dep dll_win32_export_contract -Mdll_win32_api_ms_win_crt_utility_l1_1_0=pkg/dll/win32/api-ms-win-crt-utility-l1-1-0/src/root.zig --dep dll_win32_export_contract -Mdll_win32_bcrypt=pkg/dll/win32/bcrypt/src/root.zig -Mdll_win32_cfgmgr32=pkg/dll/win32/cfgmgr32/src/root.zig --dep dll_win32_export_contract -Mdll_win32_dwmapi=pkg/dll/win32/dwmapi/src/root.zig --dep dll_win32_export_contract -Mdll_win32_dxgi=pkg/dll/win32/dxgi/src/root.zig -Mdll_win32_vulkan_1=pkg/dll/win32/vulkan-1/src/root.zig -Mdll_win32_dynamic=pkg/dll/win32/dynamic/src/root.zig --dep dll_win32_export_contract -Mdll_win32_gdi32=pkg/dll/win32/gdi32/src/root.zig -Mdll_win32_hid=pkg/dll/win32/hid/src/root.zig --dep dll_win32_export_contract -Mdll_win32_imm32=pkg/dll/win32/imm32/src/root.zig -Mdll_win32_libusbk=pkg/dll/win32/libusbk/src/root.zig --dep dll_win32_export_contract -Mdll_win32_kernel32=pkg/dll/win32/kernel32/src/root.zig --dep dll_win32_export_contract -Mdll_win32_msvcrt=pkg/dll/win32/msvcrt/src/root.zig --dep dll_win32_export_contract -Mdll_win32_ole32=pkg/dll/win32/ole32/src/root.zig --dep dll_win32_export_contract -Mdll_win32_oleaut32=pkg/dll/win32/oleaut32/src/root.zig --dep dll_win32_export_contract -Mdll_win32_setupapi=pkg/dll/win32/setupapi/src/root.zig -Mdll_win32_shcore=pkg/dll/win32/shcore/src/root.zig --dep dll_win32_export_contract -Mdll_win32_shell32=pkg/dll/win32/shell32/src/root.zig --dep dll_win32_export_contract -Mdll_win32_shlwapi=pkg/dll/win32/shlwapi/src/root.zig --dep dll_win32_export_contract -Mdll_win32_user32=pkg/dll/win32/user32/src/root.zig --dep dll_win32_export_contract -Mdll_win32_version=pkg/dll/win32/version/src/root.zig --dep dll_win32_export_contract -Mdll_win32_winmm=pkg/dll/win32/winmm/src/root.zig -Mdll_win32_winusb=pkg/dll/win32/winusb/src/root.zig --dep dll_win32_export_contract -Mdll_win32_wsock32=pkg/dll/win32/wsock32/src/root.zig -Mx64_guest_abi=src/x64-ASM/guest_abi.zig -Mexit_diagnostics=src/tooling/exit_diagnostics/root.zig -Misa_highway=ISA/highway.zig -Misa_registry=ISA/root.zig -Misa_decode=ISA/decode/root.zig -Mruntime_abi_handshake=src/tooling/runtime-abi-handshake/runtime.zig -Mguard_rollback=lib/runtime/guard-rollback/root.zig -Mcleo_routing=lib/CLEO/cleo_routing.zig -Mexecution_history=lib/runtime/execution-history/root.zig --dep x64_decoder --dep exit_diagnostics -Mevex_runtime=lib/runtime/process-core/evex.zig --dep x64_decoder --dep phrase_filter -Mconsole_fatal_condition_map=pkg/common/console/fatal-condition-map/src/root.zig -Mconsole_guest_frontier_map=pkg/common/console/guest-frontier-map/src/root.zig -Mconsole_guest_milestone_map=pkg/common/console/guest-milestone-map/src/root.zig -Mxenia_guest_address_map=pkg/common/console/guest-address-map/src/root.zig -Mframe_content_contract=pkg/common/rosette/frame-content-contract/src/root.zig -Mscreen_validity=lib/gpu/screen_validity.zig -Maddress_region_map=pkg/common/rosette/address-region-map/src/root.zig --dep phrase_filter -Mconsole_warning_severity_map=pkg/common/console/warning-severity-map/src/root.zig -Mphrase_filter=pkg/common/text/phrase-filter/src/root.zig --dep x64_decoder -Mx86_vector_helpers=lib/Mach-O/execution_helpers.zig --dep dll_win32_return_contract -Mdll_win32_export_contract=pkg/dll/win32/export-contract/src/root.zig -Mdll_win32_capability_gap=pkg/dll/win32/capability-gap/src/root.zig -Mconsole_kernel_shim_map=pkg/common/console/kernel-shim-map/src/root.zig -Mconsole_kernel_export_map=pkg/common/console/kernel-export-map/src/root.zig -Marm64_encode=lib/compiler/arm64/encode.zig -Mtso_memory=lib/processor/ELF_processor/tso_memory.zig -Mutf8_codec=lib/text/utf8/root.zig -Mconcurrency=lib/concurrency/root.zig --dep concurrency -Mparallelism=lib/processor/ELF_processor/parallelism/root.zig -femit-bin="$(ELF_PROCESSOR_BIN)"

macho-processor-build:
	@mkdir -p "$(ZIG_CACHE_DIR)/global"
	@cd "$(ROOT_DIR)" && ZIG_LOCAL_CACHE_DIR="$(ZIG_CACHE_DIR)" ZIG_GLOBAL_CACHE_DIR="$(ZIG_GLOBAL_CACHE_DIR)" zig build --build-file "$(COORD_BUILD_FILE)" --prefix "$(ZIG_OUT_DIR)" -Doptimize="$(ROSETTE_RUNTIME_OPTIMIZE)" macho-processor

# The dyld forwarder is shared by ELF and Mach-O processor roots. Rebuild both
# consumers after its focused test so either installed processor sees the same
# source revision.
dyld-processor-build: elf-processor-build macho-processor-build

elf-processor-dylib:
	@mkdir -p "$(ZIG_OUT_DIR)/lib"
	@cd "$(ROOT_DIR)" && ZIG_LOCAL_CACHE_DIR="$(ZIG_CACHE_DIR)" ZIG_GLOBAL_CACHE_DIR="$(ZIG_GLOBAL_CACHE_DIR)" zig cc -dynamiclib -arch arm64 \
		-o "$(DYLD_DYLIB)" \
		"$(ROOT_DIR)/src/shell/dyld/rosette-exec.c" \
		-install_name @rpath/rosette-exec.dylib
	@echo "Built $(DYLD_DYLIB)"

avx-shim-build:
	@mkdir -p "$(ZIG_OUT_DIR)/lib"
	@cd "$(ROOT_DIR)" && ZIG_LOCAL_CACHE_DIR="$(ZIG_CACHE_DIR)" ZIG_GLOBAL_CACHE_DIR="$(ZIG_GLOBAL_CACHE_DIR)" zig cc -target x86_64-macos -dynamiclib \
		-o "$(AVX_SHIM_DYLIB)" \
		"$(ROOT_DIR)/src/compat/rosetta2/avx-shim.c" \
		-install_name @rpath/avx-shim.dylib \
		-Wl,-dead_strip_dylibs
	@echo "Built $(AVX_SHIM_DYLIB)"
