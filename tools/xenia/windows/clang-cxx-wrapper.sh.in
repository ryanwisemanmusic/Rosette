#!/usr/bin/env bash
set -euo pipefail

clangxx="@CLANGXX@"
source_root="@SOURCE_ROOT@"
support_tmp="@SUPPORT_TMP@"
support_include="@SUPPORT_DIR@/include"
target_triple="x86_64-w64-windows-gnu"

rewritten=()
temporary_sources=()
args=("$@")
index=0
needs_winsock=0
is_link=1

cleanup() {
  [ "${#temporary_sources[@]}" -gt 0 ] || return 0
  local path
  for path in "${temporary_sources[@]}"; do
    rm -f "$path"
  done
}
trap cleanup EXIT

while [ "$index" -lt "${#args[@]}" ]; do
  arg="${args[$index]}"
  case "$arg" in
    -c|-E|-S|-fsyntax-only|-M|-MM)
      is_link=0
      ;;
  esac

  if [ "$arg" = "-Xclang" ] &&
    [ "$((index + 1))" -lt "${#args[@]}" ]; then
    next="${args[$((index + 1))]}"
    case "$next" in
      --dependent-lib=*)
        index=$((index + 2))
        continue
        ;;
    esac
  fi

  case "$arg" in
    /Od)
      rewritten+=("-O0")
      ;;
    /O[123s])
      rewritten+=("-${arg#/}")
      ;;
    /Ob*|/Oi|/Oy|/GL|/Gw|/Gy)
      ;;
    -flto|-flto=*)
      # ThinLTO currently loses the stable COFF constructor ordering that
      # MinGW's __do_global_ctors relies on. Keep PE startup deterministic;
      # this is capsule policy and leaves the inspected Xenia sources intact.
      ;;
    -arch|-isysroot|-iframework)
      # CMake can inherit these host-Darwin options when a nested project
      # configures itself. They are invalid for the Windows/COFF target, and
      # the option's following value belongs to the host option as well.
      index=$((index + 2))
      continue
      ;;
    -mmacosx-version-min=*|-miphoneos-version-min=*|-mios-simulator-version-min=*)
      index=$((index + 1))
      continue
      ;;
    -F*|-Wl,-search_paths_first|-Wl,-headerpad_max_install_names|-Wl,-syslibroot,*|-Wl,-platform_version,*|-Wl,-macosx_version_min,*)
      index=$((index + 1))
      continue
      ;;
    */socket_win.cc)
      needs_winsock=1
      ;;
    */mapped_memory_win.cc)
      source_temp="$(mktemp "$support_tmp/mapped-memory.XXXXXX")"
      source_override="$source_temp.cc"
      sed \
        's/static inline constexpr HANDLE kFileHandleInvalid/static inline const HANDLE kFileHandleInvalid/' \
        "$arg" > "$source_override"
      temporary_sources+=("$source_temp" "$source_override")
      rewritten+=("$source_override")
      index=$((index + 1))
      continue
      ;;
    */stack_walker_win.cc)
      source_temp="$(mktemp "$support_tmp/stack-walker.XXXXXX")"
      source_override="$source_temp.cc"
      sed -E 's/__in[[:space:]]+//g' "$arg" > "$source_override"
      temporary_sources+=("$source_temp" "$source_override")
      rewritten+=("$source_override")
      index=$((index + 1))
      continue
      ;;
  esac

  case "$arg" in
    /Od|/O[123s]|/Ob*|/Oi|/Oy|/GL|/Gw|/Gy|-flto|-flto=*)
      # These options were already translated or intentionally removed by
      # the compatibility pass above. Do not append their original spelling.
      ;;
    -fuse-ld=lld)
      rewritten+=("-fuse-ld=@LLD@")
      ;;
    -l*.lib)
      rewritten+=("${arg%.lib}")
      ;;
    -fuse-ld=lld-link|-loldnames|-nostartfiles|-nostdlib|/arch:SSE2)
      ;;
    *)
      rewritten+=("$arg")
      ;;
  esac
  index=$((index + 1))
done

compiler_args=(
  "--target=$target_triple"
  -fms-extensions
  -fms-compatibility
  -fms-compatibility-version=19
  # -fms-compatibility removes these Clang compatibility macros. Restore
  # Clang's real GCC compatibility level, NOT libstdc++'s version. Advertising
  # GCC 13 selected GCC-only pragmas and features in unchanged third-party code.
  -D__GNUC__=4 -D__GNUC_MINOR__=2 -D__GNUC_PATCHLEVEL__=1
  -D__GCC_ATOMIC_BOOL_LOCK_FREE=2
  -D__GCC_ATOMIC_CHAR8_T_LOCK_FREE=2
  -D__GCC_ATOMIC_CHAR16_T_LOCK_FREE=2
  -D__GCC_ATOMIC_CHAR32_T_LOCK_FREE=2
  -D__GCC_ATOMIC_CHAR_LOCK_FREE=2
  -D__GCC_ATOMIC_INT_LOCK_FREE=2
  -D__GCC_ATOMIC_LLONG_LOCK_FREE=2
  -D__GCC_ATOMIC_LONG_LOCK_FREE=2
  -D__GCC_ATOMIC_POINTER_LOCK_FREE=2
  -D__GCC_ATOMIC_SHORT_LOCK_FREE=2
  -D__GCC_ATOMIC_TEST_AND_SET_TRUEVAL=1
  -D__GCC_ATOMIC_WCHAR_T_LOCK_FREE=2
  -DXE_COMPILER_MSVC=1
  -DXE_COMPILER_CLANG_CL=1
  -DXE_COMPILER_HAS_MSVC_EXTENSIONS=1
  -DUNICODE -D_UNICODE
  -include "$support_include/xenia_cxx_compat.h"
  -ivfsoverlay "@CPP_OVERLAY@"
)
if [ "$needs_winsock" -eq 1 ]; then
  compiler_args+=(-include winsock2.h)
fi
compiler_args+=(
  -I"$source_root"
  -I"$source_root/src"
  -I"$support_include"
  -Wno-error=macro-redefined
  -Wno-error=cpp
  -Wno-error=unknown-warning-option
  # The token-aware ABI profile fixes these at source. Keep them fatal:
  # an upstream pattern change must surface, not silently reintroduce them.
  -Werror=format
  -Werror=tautological-pointer-compare
  -Werror=microsoft-cast
  -Werror=ignored-pragmas
  -Werror=undefined-inline
  -Werror=multichar
)
if [ "${#rewritten[@]}" -gt 0 ]; then
  compiler_args+=("${rewritten[@]}")
fi
if [ "$is_link" -eq 1 ]; then
  compiler_args+=(
    # Keep the C++ and GCC runtimes inside the PE whenever the cross toolchain
    # provides their static archives.  A Windows PE cannot resolve MinGW's
    # libstdc++ ABI against the host libc++ runtime, and leaving these imports
    # external turns every C++ exception/string/filesystem edge into a false
    # Windows-ABI preflight failure.  This is a link-only capsule policy; it
    # does not alter Xenia's source or its C++ object files.
    -static-libstdc++
    -static-libgcc
    -municode
    -lntdll
    -lwsock32
    -lws2_32
    -lxinput
    -lcomctl32
    -lshcore
    -lshlwapi
    -ldxguid
    -lksuser
    -lksguid
    # The pthread shim is part of MinGW's Windows runtime, not a host
    # library. Keep it in the PE as well so pthread synchronization does not
    # become another unresolved DLL surface in Rosetta.
    -Wl,-Bstatic
    -lwinpthread
    -Wl,-Bdynamic
    -lucrt
  )
fi

"$clangxx" "${compiler_args[@]}"
