/* The Xbox-kernel source intentionally uses these names as members of its
 * guest CreateOptions enum. Win32 exposes the same spellings as macros, so
 * remove only the colliding aliases after the system headers have consumed
 * them. */
#ifdef FILE_DIRECTORY_FILE
#undef FILE_DIRECTORY_FILE
#endif
#ifdef FILE_SEQUENTIAL_ONLY
#undef FILE_SEQUENTIAL_ONLY
#endif
#ifdef FILE_SYNCHRONOUS_IO_ALERT
#undef FILE_SYNCHRONOUS_IO_ALERT
#endif
#ifdef FILE_SYNCHRONOUS_IO_NONALERT
#undef FILE_SYNCHRONOUS_IO_NONALERT
#endif
#ifdef FILE_NON_DIRECTORY_FILE
#undef FILE_NON_DIRECTORY_FILE
#endif
#ifdef FILE_RANDOM_ACCESS
#undef FILE_RANDOM_ACCESS
#endif

/* MinGW suppresses its __cpuidex declaration for GCC 11 and newer. Clang's
 * MS-compatibility mode does not provide the declaration either, while Xbyak
 * uses the MSVC spelling on the Windows target. The MinGW intrin header has
 * already supplied __cpuid_count by this point, so preserve the same inline
 * implementation without modifying the third-party source. */
#ifndef XENIA_CANARY_CPUIDEX_SHIM
#define XENIA_CANARY_CPUIDEX_SHIM 1
static inline void xenia_canary_cpuidex(int CPUInfo[4], int function_id,
                                        int subfunction_id) {
  __cpuid_count(function_id, subfunction_id, CPUInfo[0], CPUInfo[1],
                CPUInfo[2], CPUInfo[3]);
}
#ifndef __cpuidex
#define __cpuidex xenia_canary_cpuidex
#endif
#endif

#endif
