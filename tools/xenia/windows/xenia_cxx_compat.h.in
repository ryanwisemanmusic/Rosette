/* C++-only preinclude for the external Windows validation build. */
#ifndef XENIA_CANARY_CXX_COMPAT_H_
#define XENIA_CANARY_CXX_COMPAT_H_

#include "xenia_windows_compat.h"

/* Load MinGW's ordinary Windows headers before advertising the MSVC macro.
 * DirectX-Headers and DXC then select their C++ ABI declarations without
 * changing how the MinGW Shell/COM headers were parsed. */
#include "@SOURCE_ROOT@/src/xenia/base/platform_win.h"
#include <cstdlib>

/* Forward declarations for the interface types whose UUIDs are supplied by
 * DirectX-Headers, DXC, or the optional PIX stub later in the include graph.
 * MinGW's headers provide __CRT_UUID_DECL specializations for their own COM
 * interfaces, but those third-party headers use MSVC's __declspec(uuid(...))
 * form and do not emit MinGW specializations. */
struct ID3D12Debug;
struct ID3D12Device;
struct ID3D12InfoQueue;
struct ID3D12CommandQueue;
struct ID3D12Resource;
struct ID3D12CommandAllocator;
struct ID3D12GraphicsCommandList;
struct ID3D12GraphicsCommandList1;
struct ID3D12GraphicsCommandList2;
struct ID3D12DescriptorHeap;
struct ID3D12Fence;
struct ID3D12PipelineState;
struct ID3D12RootSignature;
struct ID3D12Heap;
struct ID3D12QueryHeap;
struct IDXGraphicsAnalysis;
struct IDxbcConverter;
struct IDxcUtils;
struct IDxcCompiler;

/* This MinGW libstdc++ configuration has no CRT quick_exit entry even though
 * the C++ header exposes the function on native MSVC. Xenia uses it only for
 * the fatal title-exit path; preserve the no-return behavior for this
 * validation build without changing the upstream source. */
#if __cplusplus >= 201103L && !defined(_GLIBCXX_HAVE_QUICK_EXIT)
namespace std {
[[noreturn]] inline void quick_exit(int status) noexcept {
  (void)status;
  std::abort();
}
}  // namespace std
#endif

/* MinGW's rpcndr.h reduces MIDL_INTERFACE to a plain struct, but the
 * DirectX-Headers interfaces use __uuidof through IID_PPV_ARGS. */
#ifdef MIDL_INTERFACE
#undef MIDL_INTERFACE
#endif
#define MIDL_INTERFACE(x) struct __declspec(uuid(x))

#ifndef _MSC_VER
#define _MSC_VER 1939
#endif

/* The MinGW __uuidof emulation cannot derive GUIDs from MSVC-style
 * __declspec(uuid(...)) declarations. XAudio2's private compatibility
 * interfaces use that declaration form, so provide the two corresponding
 * specializations in this external build header. */
namespace xe {
namespace apu {
namespace xaudio2 {
namespace api {
class XAudio2_7;
struct IXAudio2_7;
}  // namespace api
}  // namespace xaudio2
}  // namespace apu
}  // namespace xe

__CRT_UUID_DECL(xe::apu::xaudio2::api::XAudio2_7, 0x5a508685, 0xa254,
                0x4fba, 0x9b, 0x82, 0x9a, 0x24, 0xb0, 0x03, 0x06, 0xaf)
__CRT_UUID_DECL(xe::apu::xaudio2::api::IXAudio2_7, 0x8bcf1f58, 0x9fe7,
                0x4583, 0x8a, 0xc6, 0xe2, 0xad, 0xc4, 0x65, 0xc8, 0xbb)

