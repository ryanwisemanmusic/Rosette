cmake_minimum_required(VERSION 3.20)

# The upstream root tests APPLE before its project() call. CMake preserves
# the host's Darwin value while cross-configuring, so select Windows before
# entering the untouched source mirror.
set(APPLE FALSE)
set(CMAKE_SYSTEM_NAME Windows CACHE STRING "" FORCE)
set(CMAKE_SYSTEM_PROCESSOR x86_64 CACHE STRING "" FORCE)

add_subdirectory("@SOURCE_ROOT@" "@INNER_BUILD@")
